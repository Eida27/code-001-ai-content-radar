# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=google/gemma-4-31b-it:free
OPENROUTER_FALLBACK_MODEL=google/gemma-4-31b-it
OPENROUTER_DAILY_FREE_REQUEST_LIMIT=50
ALLOW_PAID_FALLBACK=false

# Discord
DISCORD_WEBHOOK_URL=
DISCORD_MAX_ITEMS_PER_DIGEST=10

# Worker settings
MIN_IMPORTANCE_SCORE=7
MAX_AI_DRAFTS_PER_DAY=35
MAX_ITEMS_PER_RUN=30
MAX_ITEMS_PER_SOURCE=10
MAX_FEED_CANDIDATES_PER_SOURCE=30
FRESHNESS_WINDOW_HOURS=72
MAX_AI_CALLS_PER_RUN=4
MAX_PAID_FALLBACKS_PER_RUN=0
SOURCE_TIMEOUT_SECONDS=20
SOURCE_RETRY_LIMIT=1
RUN_TIMEOUT_SECONDS=720
RUN_LOCK_ENABLED=true
RUN_LOCK_TTL_SECONDS=840
REQUEST_TIMEOUT_SECONDS=20

# Production checks
PRODUCTION_DB_WARNING_MB=350
PRODUCTION_DB_FAIL_MB=450
PRODUCTION_STORAGE_WARNING_MB=750
PRODUCTION_STORAGE_FAIL_MB=950

# Retention cleanup
CLEANUP_ENABLED=true
RETENTION_LOG_DAYS=30
RETENTION_AI_RAW_RESPONSE_DAYS=14
RETENTION_LOW_PRIORITY_DAYS=30
RETENTION_WORKER_RUN_DAYS=90
CLEANUP_BATCH_LIMIT=100
